{
  // Visual Studio type-check for THIS widget. IDE-only, noEmit; the EB webpack
  // build ignores this file. Mode B (self-contained): no baseUrl, no paths,
  // "types": [], classic jsx "react". Every module the widget imports is
  // declared ambiently in src/exb-editor-shims.d.ts (master copy) and
  // src/editor-shims.d.ts (this widget's @arcgis/core + *.scss shims).
  // See WIDGETHANDOFF Section 12.3.
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Node",
    "jsx": "react",
    "types": [],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"]
}
